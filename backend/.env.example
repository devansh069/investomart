APP_NAME="InvestorMart API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=investormart
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@investormart.co.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=investormart
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

OTP_PROVIDER=log
OTP_ENDPOINT=
OTP_SERVICE_TOKEN=
OTP_SERVICE_USERID=
OTP_SERVICE_PASSWORD=
OTP_AUTH_SCHEME=PLAIN
OTP_METHOD=SendMessage
OTP_MSG_TYPE=TEXT
OTP_API_VERSION=1.1
OTP_SENDER_PREFIX=
OTP_MESSAGE_TEMPLATE="INMART OTP for CRM is {OTP}. Do not share it with anyone"
# Set only when a local PHP installation has no trusted CA bundle.
OTP_CA_BUNDLE=
OTP_SENDER_ID=
# Required for Indian operator DLT delivery when provided by the Gupshup account.
OTP_DLT_ENTITY_ID=
OTP_DLT_TEMPLATE_ID=
OTP_EXPIRY_SECONDS=600
OTP_RESEND_SECONDS=30
OTP_MAX_RESENDS_PER_HOUR=3
OTP_MAX_ATTEMPTS=5
# Configure only in APP_ENV=staging. Never set these in production.
OTP_STAGING_TEST_PHONE=
OTP_STAGING_TEST_CODE=
# Local development only. Never put real customer numbers or production values here.
OTP_LOCAL_TEST_ACCOUNTS=
OTP_LOCAL_TEST_CODE=

# Server-to-server key for the legacy web admin API. Set only in secure server secrets.
ADMIN_API_KEY=

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_CAPTURE_MODE=automatic

INVESTORMART_BASE_LISTING_SLOTS=10
INVESTORMART_PLAN_TIMEZONE=Asia/Kolkata
INVESTORMART_LEGACY_MEDIA_BASE_URL=
INVESTORMART_LEGACY_PROPERTY_MEDIA_PREFIX=property_folder/property_gallary
INVESTORMART_MOBILE_PROPERTY_UPLOAD_PREFIX=properties/mobile
INVESTORMART_MEDIA_PUBLIC_BASE_URL=
INVESTORMART_ADMIN_MOBILE_NUMBERS=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
